ISSUER=http://localhost:8000

DB_USER=auth
DB_PASSWORD=auth
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

SIGNING_KEY_DIR=./keys

# seeded admin account (only used if no admin exists yet); change the password
# via /admin/account after first login, or override these before first boot
DEFAULT_ADMIN_EMAIL=admin@localhost
DEFAULT_ADMIN_PASSWORD=admin123!

# used only for docker-compose variable interpolation (container network hostnames)
COMPOSE_DB_HOST=postgres
COMPOSE_REDIS_HOST=redis

# email (password reset + email verification) -- any SMTP provider works:
# Postfix relay, Amazon SES, SendGrid, Mailgun, Resend all expose an SMTP endpoint
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=Auth Service
