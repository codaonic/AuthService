ISSUER=http://localhost:8000

DB_USER=auth
DB_PASSWORD=auth
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth

# Optional: a restricted, non-superuser role for the app to serve requests
# as -- see README's "Row-level security" section. Leave unset to keep
# using DB_USER/DB_PASSWORD for everything (the default, pre-existing
# behavior).
DB_APP_USER=
DB_APP_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

SIGNING_KEY_DIR=./keys

# Optional, for scripted/automated deployments only -- leave both unset (the
# default) and the first person to open /admin gets an interactive setup
# screen to choose their own email/password instead. Only set these if
# something needs a working admin login without a human driving that screen.
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=choose-a-strong-one

# used only for docker-compose variable interpolation (container network hostnames)
COMPOSE_DB_HOST=postgres
COMPOSE_REDIS_HOST=redis

# email (password reset + email verification) -- any SMTP provider works:
# Postfix relay, Amazon SES, SendGrid, Mailgun, Resend all expose an SMTP endpoint
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@localhost
EMAIL_FROM_NAME=Auth Service

# mutual-TLS client auth for client_credentials clients -- leave empty to
# disable entirely (the default and the safe choice unless you've set up
# the matching nginx config; see README's mTLS section). This must be a
# secret only your reverse proxy knows, generated with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MTLS_TRUSTED_PROXY_SECRET=
