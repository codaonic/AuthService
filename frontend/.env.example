# Only read by vite.config.ts itself (Node-side, at `npm run dev` startup),
# never shipped to the browser -- where the Vite dev server proxies
# /admin/api/* to while you're running the frontend with `npm run dev`
# (real HMR, no container rebuild per change). Not used by `npm run build`;
# the built bundle always calls /admin/api on its own origin.
#
# Point this at whichever backend you're actually running against:
#   - `uv run uvicorn app.main:app --reload` on the host -> default below
#   - the full docker-compose stack on :8113       -> http://localhost:8113
VITE_BACKEND_URL=http://localhost:8000
